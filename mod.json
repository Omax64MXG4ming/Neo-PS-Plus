{
    "geode": "6.0.0-alpha.2",
    "gd": {
        "win": "2.2091",
		"android": "2.2091",
		"mac": "2.2091"
    },
    "id": "omarstudios.neo",
    "name": "Neo PS Plus",
    "version": "1.1.0",
    "developer": "Omar Studios",
    "description": "An Mod For Neo PS, Uses Backend and More Inspector",
		"links": {
		"source": "https://github.com/Omax64MXG4ming/Neo-PS-Plus",
	    "community": "https://discord.gg/TdB33cAyMn"
	},
	"issues": {
		"url": "https://github.com/Omax64MXG4ming/neo-android-launcher/issues",
		"info": "If you see or detect an error or bug within the launcher or while playing, please report it to the GitHub issues page."
	},
    "settings": {
		"restart-title": {
            "type": "title",
            "name": "Restart Buttons MenuLayer"
        },
        "exit": {
            "type": "bool",
            "name": "Exit Button",
            "description": "Show the exit button.",
            "default": true
        },
        "restart": {
            "type": "bool",
            "name": "Restart Button",
            "description": "Show the restart button.",
            "default": true
        },
        "reload-textures": {
            "type": "bool",
            "name": "Reload Textures Button",
            "description": "Show the texture reload button.",
            "default": true
        },
        "size": {
            "type": "float",
            "name": "Button Size",
            "description": "Changes the size of the menu buttons.",
            "default": 1.0,
            "min": 0.5,
            "max": 2.0
        },
        "keybind_anywhere": {
            "type": "bool",
            "name": "Keybind Anywhere",
            "description": "Allow keybinds outside the main menu, except the level editor.",
            "default": true
        },
        "restart-keybind": {
            "type": "keybind",
            "name": "Restart Game Keybind",
            "default": "Ctrl+Shift+R"
        },
        "reload-keybind": {
            "type": "keybind",
            "name": "Reload Textures Keybind",
            "default": "Ctrl+Shift+T"
        },
		"neops-title": {
            "type": "title",
            "name": "Neo Intercept Settings"
        },
        "backend-url": {
            "name": "Backend URL",
            "description": "Backend server URL",
            "type": "string",
            "default": "https://neops.x10.mx/database"
        },
        "intercept-enabled": {
            "name": "Enable Intercept",
            "description": "Capture Cocos requests",
            "type": "bool",
            "default": true
        },
        "intercept-all-servers": {
            "name": "Intercept All Servers",
            "description": "Capture requests regardless of server",
            "type": "bool",
            "default": true
        },
		"screen-title": {
            "type": "title",
            "name": "ScreenSaver Options"
        },
    
        "wait-time": {
            "name": "Idle Time (seconds)",
            "description": "how long till screensaver starts",
            "type": "int",
            "default": 30,
            "min": 5,
            "max": 300,
            "control": {
                "slider": true,
                "arrows": true,
                "arrow-step": 5
            }
        },
        "physics-speed": {
            "name": "Speed",
            "description": "gravity multiplier",
            "type": "int",
            "default": 10,
            "min": 1,
            "max": 20,
            "control": {
                "slider": true,
                "arrows": true
            }
        },
        "item-count": {
            "name": "Orb Count",
            "description": "how many orbs spawn per cycle",
            "type": "int",
            "default": 120,
            "min": 1,
            "max": 300,
            "control": {
                "slider": true,
                "arrows": true,
                "arrow-step": 10
            }
        },
        "player-chance": {
            "name": "Cube Chance (%)",
            "description": "chance your cube shows up too",
            "type": "int",
            "default": 50,
            "min": 0,
            "max": 100,
            "control": {
                "slider": true,
                "arrows": true
            }
        },
        "background-mode": {
            "name": "Background Type",
            "description": "what kind of background (blur needs BlurAPI)",
            "type": "string",
            "default": "color",
            "one-of": ["color", "image", "blur"]
        },
        "overlay-color": {
            "name": "Background Color",
            "description": "rgb color for the overlay",
            "type": "rgb",
            "default": [0, 0, 0]
        },
        "overlay-opacity": {
            "name": "Background Opacity",
            "description": "transparency level (0 = see through, 255 = solid)",
            "type": "int",
            "default": 200,
            "min": 0,
            "max": 255
        },
        "image-path": {
            "name": "Background Image",
            "description": "file path for custom image (only works if type is set to image)",
            "type": "file",
            "default": ""
        },
        "image-fit": {
            "name": "Image Fit",
            "description": "stretch = fill screen, zoom = keep ratio and crop",
            "type": "string",
            "default": "stretch",
            "one-of": ["stretch", "zoom"]
        },
        "infinite-fall": {
            "name": "No Ground (Infinite Fall)",
            "description": "orbs just fall forever instead of piling up",
            "type": "bool",
            "default": false
        },

"percentage-title": {
    "type": "title",
    "name": "Percentage Customizer"
},

"size": {
    "type": "float",
    "name": "Size",
    "description": "Scale of the percentage label. GD's default is 0.5.",
    "default": 0.5,
    "min": 0.1,
    "max": 3.0,
    "control": {
        "slider": true,
        "input": true,
        "arrows": true,
        "arrow-step": 0.05,
        "slider-step": 0.05
    }
},

"color": {
    "type": "color",
    "name": "Color",
    "default": "#ffffff"
},

"font": {
    "type": "string",
    "name": "Font",
    "description": "Built-in Geometry Dash fonts.",
    "default": "bigFont",
    "one-of": [
        "bigFont",
        "goldFont",
        "chatFont",
        "gjFont01",
        "gjFont02",
        "gjFont03",
        "gjFont04",
        "gjFont05",
        "gjFont06",
        "gjFont07",
        "gjFont08",
        "gjFont09",
        "gjFont10",
        "gjFont11",
        "gjFont12",
        "gjFont13",
        "gjFont14",
        "gjFont15",
        "gjFont16",
        "gjFont17",
        "gjFont18",
        "gjFont19",
        "gjFont20",
        "gjFont21",
        "gjFont22",
        "gjFont23",
        "gjFont24",
        "gjFont25",
        "gjFont26",
        "gjFont27",
        "gjFont28",
        "gjFont29",
        "gjFont30",
        "gjFont31",
        "gjFont32",
        "gjFont33",
        "gjFont34",
        "gjFont35",
        "gjFont36",
        "gjFont37",
        "gjFont38",
        "gjFont39",
        "gjFont40",
        "gjFont41",
        "gjFont42",
        "gjFont43",
        "gjFont44",
        "gjFont45",
        "gjFont46",
        "gjFont47",
        "gjFont48",
        "gjFont49",
        "gjFont50",
        "gjFont51",
        "gjFont52",
        "gjFont53",
        "gjFont54",
        "gjFont55",
        "gjFont56",
        "gjFont57",
        "gjFont58",
        "gjFont59"
    ]
},

"margin": {
    "type": "float",
    "name": "Margin",
    "description": "Distance in pixels from the screen edge. Has no effect on the center axis.",
    "default": 10.0,
    "min": 0.0,
    "max": 200.0,
    "control": {
        "slider": true,
        "input": true,
        "arrows": true,
        "arrow-step": 1,
        "slider-step": 1
    }
},

"position": {
    "type": "string",
    "name": "Position",
    "default": "Top Center",
    "one-of": [
        "Top Left",
        "Top Center",
        "Top Right",
        "Center Left",
        "Center",
        "Center Right",
        "Bottom Left",
        "Bottom Center",
        "Bottom Right"
    ]
},

"opacity": {
    "type": "int",
    "name": "Opacity",
    "description": "0 is invisible, 100 is fully opaque.",
    "default": 100,
    "min": 0,
    "max": 100,
    "control": {
        "slider": true,
        "input": true,
        "arrows": true,
        "arrow-step": 1,
        "slider-step": 1
    }
}
    },
    "dependencies": {
        "thesillydoggo.blur-api": {
            "version": ">=v1.0.0",
            "required": false
		},
		"geode.node-ids": ">=v1.23.3"
    }
}
