{
    "geode": "6.0.0",
    "gd": {
        "win": "2.2091",
		"android": "2.2091",
		"mac": "2.2091",
		"ios": "2.2091"
    },
    "id": "omarstudios.neo",
    "name": "Neo PS Plus",
    "version": "1.1.3",
    "developer": "Omar Studios",
    "description": "An Mod For Neo PS, Uses Fixes and More Things for Better Playing!",
		"links": {
		"source": "https://github.com/Omax64MXG4ming/Neo-PS-Plus",
	    "community": "https://discord.gg/TdB33cAyMn",
	    "homepage": "https://neops.x10.mx"
	},
	"issues": {
		"url": "https://github.com/Omax64MXG4ming/neo-android-launcher/issues",
		"info": "If you see or detect an error or bug within the launcher or while playing, please report it to the GitHub issues page."
	},
		"resources": {
		"files": [
			"resources/shaders/*.glsl",
			"resources/neo-hub/*.png"
		]
	},
    "settings": {
		"restart-title": {
            "type": "title",
            "name": "Restart Buttons MenuLayer"
        },
        "exit": {
            "type": "bool",
            "name": "Exit Button",
            "description": "Show the exit button.",
            "default": true
        },
        "restart": {
            "type": "bool",
            "name": "Restart Button",
            "description": "Show the restart button.",
            "default": true
        },
        "reload-textures": {
            "type": "bool",
            "name": "Reload Textures Button",
            "description": "Show the texture reload button.",
            "default": true
        },
        "size": {
            "type": "float",
            "name": "Button Size",
            "description": "Changes the size of the menu buttons.",
            "default": 1.0,
            "min": 0.5,
            "max": 2.0
        },
        "keybind_anywhere": {
            "type": "bool",
            "name": "Keybind Anywhere",
            "description": "Allow keybinds outside the main menu, except the level editor.",
            "default": true
        },
        "restart-keybind": {
            "type": "keybind",
            "name": "Restart Game Keybind",
            "default": "Ctrl+Shift+R"
        },
        "reload-keybind": {
            "type": "keybind",
            "name": "Reload Textures Keybind",
            "default": "Ctrl+Shift+T"
        },

		"screen-title": {
            "type": "title",
            "name": "ScreenSaver Options"
        },
    
        "wait-time": {
            "name": "Idle Time (in seconds)",
            "description": "how long till screensaver starts",
            "type": "int",
            "default": 60,
            "min": 5,
            "max": 300,
            "control": {
                "slider": true,
                "arrows": true,
                "arrow-step": 5
            }
        },
        "physics-speed": {
            "name": "Speed",
            "description": "gravity multiplier",
            "type": "int",
            "default": 1,
            "min": 1,
            "max": 15,
            "control": {
                "slider": true,
                "arrows": true
            }
        },
        "item-count": {
            "name": "Orb Count",
            "description": "how many orbs spawn per cycle",
            "type": "int",
            "default": 150,
            "min": 1,
            "max": 500,
            "control": {
                "slider": true,
                "arrows": true,
                "arrow-step": 10
            }
        },
        "player-chance": {
            "name": "Cube Chance (%)",
            "description": "chance your cube shows up too",
            "type": "int",
            "default": 50,
            "min": 0,
            "max": 100,
            "control": {
                "slider": true,
                "arrows": true
            }
        },
        "background-mode": {
            "name": "Background Type",
            "description": "what kind of background (blur needs BlurAPI)",
            "type": "string",
            "default": "color",
            "one-of": ["color", "image", "blur"]
        },
        "overlay-color": {
            "name": "Background Color",
            "description": "rgb color for the overlay",
            "type": "rgb",
            "default": [0, 0, 0]
        },
        "overlay-opacity": {
            "name": "Background Opacity",
            "description": "transparency level (0 = see through, 255 = solid)",
            "type": "int",
            "default": 200,
            "min": 0,
            "max": 255
        },
        "image-path": {
            "name": "Background Image",
            "description": "file path for custom image (only works if type is set to image)",
            "type": "file",
            "default": ""
        },
        "image-fit": {
            "name": "Image Fit",
            "description": "stretch = fill screen, zoom = keep ratio and crop",
            "type": "string",
            "default": "stretch",
            "one-of": ["stretch", "zoom"]
        },
        "infinite-fall": {
            "name": "No Ground (Infinite Fall)",
            "description": "orbs just fall forever instead of piling up",
            "type": "bool",
            "default": false
        },

"blur-title": {
            "type": "title",
            "name": "BlurAPI Options"
        },
		
	"enabled": {
			"type": "bool",
			"name": "Enabled",
			"description": "Enables blur rendering",
			"default": true
		},
		"passes": {
			"type": "int",
			"name": "Blur Passes",
			"description": "The quality of the shader",
			"min": 3,
			"max": 10,
			"default": {
				"win": 5,
				"mac": 5,
				"android": 5,
				"ios": 5
			}
		}
    },
    "dependencies": {
		"geode.node-ids": {
		 "version": ">=v1.23.3",
	     "required": false
    }
  }
}
